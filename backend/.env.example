# Copy to backend/.env and fill in. Everything works without Lyzr (rules fallback);
# with it, the intake, messenger, mediator and analyst agents run on Lyzr Agent Studio.

# Lyzr Agent Studio -> Account -> API Keys
LYZR_API_KEY=

# Simplest: ONE blank agent used for every role (each message carries its own role brief)
LYZR_AGENT_ID=

# Optional: a dedicated agent per role (overrides LYZR_AGENT_ID for that role)
LYZR_AGENT_INTAKE=
LYZR_AGENT_MESSENGER=
LYZR_AGENT_MEDIATOR=
LYZR_AGENT_ANALYST=

# LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
# LYZR_USER_ID=you@example.com
# LYZR_TIMEOUT=30

SHOP_NAME=Shree Lakshmi Jewellers
SHOP_CITY=Jaipur
JEWELLER_PIN=1234
KHATA_SECRET=change-me-to-a-long-random-string
SCALE_RESOLUTION_MG=10
